theorem fetch : UF (CPU.fetch (σ := NES)) := by sticky_tac

theorem stepTail (op : UInt8) : UF (CPU.stepTail (σ := NES) op) := by
  unfold CPU.stepTail
  refine Sticky.bind (exec op) (fun _ => ?_)
  sticky_tac

theorem step : UF (CPU.step (σ := NES)) := by
  unfold CPU.step
  exact Sticky.bind fetch stepTail

